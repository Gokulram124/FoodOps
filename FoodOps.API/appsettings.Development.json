{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Delay": {
    "PlacedAtRiskMinutes": 1,
    "PlacedDelayedMinutes": 2
  },
  "Ops": {
    "OverloadWarningOrders": 2,
    "OverloadCriticalOrders": 3,
    "ScanIntervalSeconds": 10
  }
}